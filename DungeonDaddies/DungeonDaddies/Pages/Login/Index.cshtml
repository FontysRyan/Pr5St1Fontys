@page
@model DungeonDaddies.Pages.Login.IndexModel
@{
}
<div class="text-center">
    <h1 class="display-4">INLOGGEN</h1>
    <form method="post">
		<input type="email" asp-for="Input.Email" placeholder="Email" class="form-control mb-2" required />
		<span asp-validation-for="Input.Email"></span>

		<input type="password" asp-for="Input.Password" placeholder="Wachtwoord" class="form-control mb-2" required />
		<span asp-validation-for="Input.Password"></span>

		<a asp-page="/Register/Index">Registreren</a>

		<button type="submit" class="btn btn-primary">Inloggen</button>
    </form>
</div>