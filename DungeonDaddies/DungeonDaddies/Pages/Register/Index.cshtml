@page
@model DungeonDaddies.Pages.Register.IndexModel
@{
}
<div class="text-center">
	<h1 class="display-4">Registreren</h1>
	<form method="post">
		<input type="email" asp-for="Input.Email" placeholder="Email" class="form-control mb-2" required />
		<span asp-validation-for="Input.Email"></span>

		<input type="text" asp-for="Input.Username" placeholder="Gebruikersnaam" class="form-control mb-2" required />
		<span asp-validation-for="Input.Username"></span>

		<input type="password" asp-for="Input.Password" placeholder="Wachtwoord" class="form-control mb-2" required />
		<span asp-validation-for="Input.Password"></span>

		<input type="password" asp-for="Input.ConfirmPassword" placeholder="Wachtwoord bevestigen" class="form-control mb-2" required />
		<span asp-validation-for="Input.ConfirmPassword"></span>

		<input type="text" asp-for="Input.FirstName" placeholder="Wachtwoord" class="form-control mb-2" required />
		<span asp-validation-for="Input.FirstName"></span>

		<input type="text" asp-for="Input.LastName" placeholder="Wachtwoord" class="form-control mb-2" required />
		<span asp-validation-for="Input.LastName"></span>


		<button type="submit" class="btn btn-primary">Inloggen</button>
	</form>
</div>